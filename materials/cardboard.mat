// Simple lit material used by the JS demo.
// Compiled with: matc -a all -o cardboard.filamat cardboard.mat
material {
    name : cardboard,
    shadingModel : lit,
    parameters : [
        { type : float3, name : baseColor },
        { type : float,  name : metallic },
        { type : float,  name : roughness }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = getMaterialParameter("baseColor");
        material.metallic  = getMaterialParameter("metallic");
        material.roughness = getMaterialParameter("roughness");
    }
}